# Copy to speaking.env and enter your own region-matched API key.
DASHSCOPE_API_KEY=
SPEAKING_MODEL_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Beijing: https://dashscope.aliyuncs.com/compatible-mode/v1
SPEAKING_CHAT_MODEL=qwen-plus-latest
SPEAKING_TTS_PROVIDER=edgetts
SPEAKING_VOICE_EN=en-US-JennyNeural
# Optional, only for the local UE5 3D preview. Use the token file inside the UE project's Saved folder.
# ISPEAK_UE_TOKEN_FILE=C:/path/to/MetaHumanPreview/Saved/ispeak-ue-token.txt
